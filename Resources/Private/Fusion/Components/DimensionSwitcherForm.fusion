prototype(Flowpack.Media.Ui:EditMetadata.DimensionSwitcherForm) < prototype(Neos.Fusion:Component) {
    /// list<array{assetIdentity: AssetIdentity, asset: AssetInterface, formSchema: array<string, array{type: string, editor: string|null, label: string, value: string|null}>}>
    assetsWithMetadata = null
    /// Available asset dimension space points
    assetDsps = null
    /// string
    currentAssetDsp = null

    @private {
        assetIds = Neos.Fusion:Map {
            items = ${props.assetsWithMetadata}
            itemRenderer = ${item.assetIdentity.assetId.value}
        }
    }

    renderer  = afx`
        <Neos.Fusion.Form:Form
            form.target.action="editMetadata"
            form.method="get"
            form.enableReferrer={false}
            form.enableTrustedProperties={false}
            attributes.id="changeDspHashForm"
        >
            <h1 style="margin-bottom: .5rem">Select Dimension</h1>
            <Neos.Fusion.Form:Hidden field.name="assetIds" field.value={Json.stringify(private.assetIds)} />
            <Neos.Fusion.Form:Hidden field.name="assetSourceId" field.value={props.assetsWithMetadata[0].assetIdentity.assetSourceId.value} />
            <Neos.Fusion.Form:Select field.name="metaDataDimensionSpacePointHash" field.value={props.currentAssetDsp}>
                <Neos.Fusion:Loop items={props.assetDsps}>
                    <Neos.Fusion.Form:Select.Option option.value={item.hash} attributes.selected={item.hash == props.currentAssetDsp}>
                        <Neos.Fusion:Loop items={item.coordinates} itemName="coordinate" @glue=", ">
                            {coordinate.dimensionLabel}: {coordinate.valueLabel}
                        </Neos.Fusion:Loop>
                    </Neos.Fusion.Form:Select.Option>
                </Neos.Fusion:Loop>
            </Neos.Fusion.Form:Select>
        </Neos.Fusion.Form:Form>
    `
}
