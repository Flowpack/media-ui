prototype(Flowpack.Media.Ui:EditMetadata.FieldRenderer) < prototype(Neos.Fusion:Component) {
    fieldName = ''
    fieldConfig = null
    fieldNamePrefix = 'postData'
    /// boolean: true when more than one asset is edited in this batch
    isMultiAssetEdit = false

    @if.editable = ${!this.fieldConfig.editorOptions.readonly}

    @private.field = Neos.Fusion:Case {
        boolean {
            condition = ${props.fieldConfig.type == 'boolean'}
            renderer = Neos.Fusion.Form:Checkbox {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                attributes.checked = ${props.fieldConfig.value.ownValue == true}
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.value = '1'
            }
        }

        number {
            condition = ${props.fieldConfig.type == 'number'}
            renderer = Neos.Fusion.Form:Input {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                attributes.type = 'number'
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.value = ${props.fieldConfig.value.ownValue}
            }
        }

        textArea {
            condition = ${props.fieldConfig.type == 'string' && props.fieldConfig.editor == 'Neos.Neos/Inspector/Editors/TextAreaEditor'}
            renderer = Neos.Fusion.Form:Textarea {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                attributes.rows = ${props.fieldConfig.editorOptions.rows || 3}
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                content = ${props.fieldConfig.value.ownValue}
            }
        }

        dateTime {
            condition = ${props.fieldConfig.type == 'dateTime'}
            renderer = Neos.Fusion.Form:Input {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                content = ${props.fieldConfig.value.ownValue}
                attributes.type = 'datetime-local'
            }
        }

        select {
            condition = ${props.fieldConfig.editor == 'Neos.Neos/Inspector/Editors/SelectBoxEditor' && props.fieldConfig.editorOptions.values}
            renderer = Neos.Fusion.Form:Select {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.value = ${props.fieldConfig.value.ownValue}

                content = Neos.Fusion:Join {
                    placeholder = Neos.Fusion.Form:Select.Option {
                        @if.allowEmpty = ${props.fieldConfig.editorOptions.allowEmpty == true}
                        option.value = ''
                        content = ${props.fieldConfig.editorOptions.placeholder}
                    }
                    items = Neos.Fusion:Loop {
                        items = ${props.fieldConfig.editorOptions.values}
                        itemName = 'optionItem'
                        itemRenderer = Neos.Fusion.Form:Select.Option {
                            option.value = ${itemKey}
                            renderer.selected = ${itemKey == props.fieldConfig.value.ownValue}
                            content = ${optionItem.label != null ? optionItem.label : itemKey}
                        }
                    }
                }
            }
        }

        default {
            condition = true
            renderer = Neos.Fusion.Form:Input {
                attributes.id = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.name = ${props.fieldNamePrefix + '[' + props.fieldName + ']'}
                field.value = ${props.fieldConfig.value.ownValue}
            }
        }
    }

    prototype(Neos.Fusion.Form:LabelRenderer) {
        class = 'neos-control-label'
    }

    renderer  = afx`
        <Neos.Fusion.Form:FieldContainer
            class='neos-control-group'
            label={props.fieldConfig.type != 'boolean' ? props.fieldConfig.label : ''}
            field.name={props.fieldNamePrefix + '[' + props.fieldName + ']'}
        >
            <Flowpack.Media.Ui:EditMetadata.Atom.GlobalScopeIcon
                @if.isGlobalScope={props.fieldConfig.globalScope == true}
            />
            <div class='neos-controls'>
                <label
                    class='neos-checkbox neos-inline'
                    for={props.fieldNamePrefix + '[' + props.fieldName + ']'}
                    @if.isBoolean={props.fieldConfig.type == 'boolean'}
                >
                    {private.field}
                    <span></span> {props.fieldConfig.label}
                </label>
                <Neos.Fusion:Fragment
                    @if.isNotBoolean={props.fieldConfig.type != 'boolean'}
                >
                    {private.field}
                </Neos.Fusion:Fragment>
                <small @if.hasFallback={props.fieldConfig.value.inheritedValue}>
                    Fallback: {props.fieldConfig.value.inheritedValue}
                </small>
                <Neos.Fusion:Fragment @if.hasApplyToAll={props.isMultiAssetEdit}>
                    <button
                        type="button"
                        class="neos-button neos-button-secondary metadata-editor-apply-to-all"
                        data-apply-to-all={props.fieldName}
                    >
                        {I18n.translate('metadataEditor.applyToAll', 'Apply to all', [], 'MetadataEditor', 'Flowpack.Media.Ui')}
                    </button>
                </Neos.Fusion:Fragment>
            </div>
        </Neos.Fusion.Form:FieldContainer>
    `
}
